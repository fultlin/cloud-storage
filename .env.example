NODE_ENV=development
PORT=3000

POSTGRES_USER=cloud
POSTGRES_PASSWORD=local-development-password
POSTGRES_DB=cloud_storage

DATABASE_URL=postgresql://cloud:local-development-password@127.0.0.1:5432/cloud_storage
REDIS_URL=redis://127.0.0.1:6379

# Local development only. Replace before deploying.
SESSION_SECRET=local-development-only-replace-this-secret
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
TRUST_PROXY=false

S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-development-access-key
S3_SECRET_ACCESS_KEY=local-development-secret-key
S3_BUCKET=user-files
S3_FORCE_PATH_STYLE=true

UPLOAD_MAX_FILE_SIZE_BYTES=5368709120
UPLOAD_MAX_FILES=100
SWAGGER_ENABLED=true

# Optional settings for compose.full.yaml only.
# FULL_WEB_PORT=8080
# FULL_DATABASE_URL=postgresql://cloud:local-development-password@postgres:5432/cloud_storage
# NGINX_CLIENT_MAX_BODY_SIZE=501g
