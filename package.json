    "test": "pnpm -r run test"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "oxlint": "^1.81.0"
  }
}
