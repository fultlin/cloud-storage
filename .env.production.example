# Copy to .env.production on the VPS. Fill secrets there; do not commit the file.
POSTGRES_USER=cloud
POSTGRES_DB=cloud_storage
POSTGRES_PASSWORD=
# postgresql://cloud:<url-encoded-password>@postgres:5432/cloud_storage
DATABASE_URL=

SESSION_SECRET=
SESSION_TTL_SECONDS=86400

# External S3 provider; create a private user-files bucket before startup.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

UPLOAD_MAX_FILE_SIZE_BYTES=5368709120
UPLOAD_MAX_FILES=100
NGINX_CLIENT_MAX_BODY_SIZE=501g

# HTTP smoke tests bind to loopback by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=80
