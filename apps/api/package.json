{
  "name": "@app/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "start": "pnpm prisma:generate && nest start",
    "start:dev": "pnpm prisma:generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "pnpm prisma:generate && vitest run",
    "test:watch": "pnpm prisma:generate && vitest",
    "test:e2e": "pnpm prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "verify:large-http": "pnpm build && node scripts/verify-large-http.mjs",
    "verify:large-nginx": "node scripts/verify-large-nginx.mjs",
    "verify:frontend": "pnpm build && node scripts/verify-frontend.mjs",
    "dev": "pnpm prisma:generate && nest start --watch",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "3.1152.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^7.0.1",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "connect-redis": "^10.0.0",
    "dotenv": "^18.0.8",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/archiver": "^7.0.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
