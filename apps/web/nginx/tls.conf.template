listen 443 ssl;
ssl_certificate /etc/nginx/tls/fullchain.pem;
ssl_certificate_key /etc/nginx/tls/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;

# The redirect target comes from deployment settings, never from the Host header.
if ($scheme = http) {
    return 308 https://${NGINX_HTTPS_AUTHORITY}$request_uri;
}
